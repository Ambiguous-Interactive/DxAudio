<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs the engine-free core (Runtime/Core) and its tests (Tests/Editor/Core) on plain .NET, so CI can
    check every pull request without a Unity licence. The same test files also run inside Unity.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>WallstopStudios.DxAudio</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Runtime/Core/**/*.cs" />
    <Compile Include="../Tests/Editor/Core/**/*.cs" />
    <Compile Include="../Editor/DspAuditionProcessor.cs" />
    <Compile Include="../Tests/Editor/Unity/DspAuditionProcessorTests.cs" />
    <Compile Include="../Editor/MixMonitorDropCapture.cs" />
    <Compile Include="../Tests/Editor/Unity/MixMonitorDropCaptureTests.cs" />
    <Compile Include="../Editor/MixMonitorPeakChannel.cs" />
    <Compile Include="../Editor/MixMonitorPlayerMeter.cs" />
    <Compile Include="../Tests/Editor/Unity/MixMonitorPlayerMeterTests.cs" />
    <Compile Include="../Editor/MixMonitorTimeline.cs" />
    <Compile Include="../Tests/Editor/Unity/MixMonitorTimelineTests.cs" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.15.0" PrivateAssets="all" IncludeAssets="analyzers;build" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <Target Name="CompileCoreDocSnippets" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <DocSnippetOutput>$(IntermediateOutputPath)DocSnippets</DocSnippetOutput>
    </PropertyGroup>
    <Exec Command="&quot;$(DxAudioPython)&quot; &quot;$(MSBuildProjectDirectory)/../.github/scripts/compile_docs_snippets.py&quot; --target core --output &quot;$(DocSnippetOutput)&quot;" />
    <ItemGroup>
      <Compile Include="$(DocSnippetOutput)/*.cs" />
    </ItemGroup>
  </Target>
</Project>
